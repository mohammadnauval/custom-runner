# Repository-wide safety net. Each app also has its own .gitignore.

# Dependencies
node_modules/

# Secrets — never commit connection strings or API keys
.env
.env.*
!.env.example

# Build output
.next/
dist/
build/
out/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma local databases
*.db
*.db-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
