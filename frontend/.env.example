# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string.
#
# On Vercel use a POOLED connection string (serverless functions open many
# short-lived connections):
#   Neon      -> host contains "-pooler", e.g.
#                postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
#   Supabase  -> the "Connection pooling" URI on port 6543 with ?pgbouncer=true
#
# For `npm run db:push` locally, prefer the DIRECT (unpooled) URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Time one /api/runs/[id]/execute invocation spends issuing requests, in ms.
# Must leave headroom under the function's maxDuration (60s on Vercel Hobby).
# Raise this together with `maxDuration` on Pro/Enterprise plans.
# EXEC_TIME_BUDGET_MS=30000

# How long a run's execution lease is held, in ms. Must exceed maxDuration so a
# slow invocation doesn't have its lease stolen mid-flight.
# EXEC_LEASE_MS=90000

# Per-request timeout, in ms. Keep below EXEC_TIME_BUDGET_MS.
# REQUEST_TIMEOUT_MS=20000

# Response bodies are truncated to this many characters before being stored.
# MAX_STORED_BODY_BYTES=200000
